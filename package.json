{
  "name": "dsh-daily-brief",
  "version": "2.0.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Daily briefing plugin for DeepSeek Harness: X, RSS/Atom/JSON/ICS, YouTube, Bilibili, Steam, Minecraft and status pages, mailboxes and calendars in one persona-styled card with a scheduled Windows popup.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MosesMuxiXie/dsh-daily-brief.git"
  },
  "homepage": "https://github.com/MosesMuxiXie/dsh-daily-brief#readme",
  "bugs": {
    "url": "https://github.com/MosesMuxiXie/dsh-daily-brief/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "daily-brief",
    "rss",
    "steam",
    "bilibili"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync": "git add -A && git commit -m \"sync\" --allow-empty && git push"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "imapflow": "^1.0.181",
    "mailparser": "^3.7.4",
    "node-html-parser": "^7.0.1",
    "node-ical": "^0.20.1",
    "nodemailer": "^7.0.5"
  }
}
